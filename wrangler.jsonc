{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "why-trending",
  "compatibility_date": "2026-09-17",
  "main": "./worker/index.ts",
  "vars": {
    "DATA_MODE": "real"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
