{
  "name": "trendpick",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env preview",
    "dev:worker": "npm run build && wrangler dev --env preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:collector": "wrangler deploy --config wrangler.collector.toml",
    "cron:local": "wrangler dev --config wrangler.collector.toml --test-scheduled",
    "test": "node tests/run.mjs",
    "seed:sql": "node scripts/generate-seed.mjs",
    "dev:ui": "vite",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8",
    "wrangler": "^4.133.0"
  }
}
